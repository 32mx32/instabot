# Токен вашего Telegram-бота (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Один ключ API Apify (старый формат, поддерживается для совместимости)
APIFY_API_KEY=YOUR_APIFY_API_KEY

# Несколько ключей API Apify через запятую.
# Если один ключ упрется в лимит/квоту, бот попробует следующий.
# APIFY_API_KEYS=apify_api_key_1,apify_api_key_2,apify_api_key_3

# Скачивать сначала бесплатно через yt-dlp, Apify — только как резерв (true/false)
USE_YTDLP=true

# Необязательно: cookies (формат Netscape) для yt-dlp. Instagram часто требует вход.
# Используйте отдельный аккаунт, не основной. Файл положите в папку ./cookies
# YTDLP_COOKIES_FILE=/app/cookies/instagram.txt

# Сколько скачиваний может идти одновременно
MAX_PARALLEL_DOWNLOADS=3

# ID администраторов через запятую — только им доступна /stats (пусто = всем)
# ADMIN_IDS=123456789

# Удалять файлы после отправки (true/false)
DELETE_AFTER_SEND=true
